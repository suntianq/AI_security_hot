# Copy to .env and fill in. Secrets never go in code, logs or sources.yaml.

# --- database ---
# Compose bootstrap credentials. Keep POSTGRES_PASSWORD and the URL-encoded
# password in INTEL_CONTAINER_DATABASE_URL identical.
POSTGRES_USER=intel
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=intel
INTEL_CONTAINER_DATABASE_URL=postgresql+psycopg://intel:replace-with-a-long-random-password@postgres:5432/intel
# Host-side uv/alembic commands use this URL; adjust POSTGRES_HOST_PORT as needed.
INTEL_DATABASE_URL=postgresql+psycopg://intel:replace-with-a-long-random-password@localhost:5432/intel
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000

# --- sources / storage ---
INTEL_SOURCES_FILE=sources/sources.yaml
INTEL_BLOB_DIR=data/blobs

# --- egress / proxy pools (plan 修正 3) ---
# Set the pool that matches your deployment location. Unset => direct fallback.
#   CN VM  -> set INTEL_PROXY_POOL_GLOBAL for overseas sources (GitHub/Anthropic)
#   overseas VM -> set INTEL_PROXY_POOL_CN for CN gov/vendor sources (AIVD/CNVD)
# Docker containers cannot use a host loopback proxy via 127.0.0.1.
# Linux: expose it only on the project Docker gateway (never 0.0.0.0).
# macOS Docker Desktop: use host.docker.internal and allow Docker VM access.
# INTEL_PROXY_POOL_GLOBAL=http://172.18.0.1:17897
# INTEL_PROXY_POOL_GLOBAL=http://host.docker.internal:7897
# INTEL_PROXY_POOL_CN=http://user:pass@cn-proxy:8080
# INTEL_PROXY_POOL_GLOBAL=http://user:pass@global-proxy:8080

# --- scheduler ---
INTEL_TICK_INTERVAL_SECONDS=60
INTEL_SELF_CHECK_INTERVAL_SECONDS=600
INTEL_WORKER_HEARTBEAT_FILE=data/.worker-heartbeat
INTEL_LEASE_SECONDS=900
INTEL_NORMALIZE_INTERVAL_SECONDS=10
INTEL_FULLTEXT_INTERVAL_SECONDS=30
INTEL_NORMALIZE_BATCH_SIZE=2000
INTEL_FULLTEXT_BATCH_SIZE=20

# --- optional GitHub token for higher API rate limits ---
# GITHUB_TOKEN=ghp_xxx

# --- M1.3 classification / LLM (rule is offline and default) ---
INTEL_CLASSIFICATION_MODE=rule
INTEL_CLASSIFICATION_INTERVAL_SECONDS=30
INTEL_EVENT_INTERVAL_SECONDS=60
# Defer scheduled M2 local updates/replay batches while M1 backlog exceeds this; 0 disables.
INTEL_EVENT_BACKLOG_THRESHOLD=1000
INTEL_M2_SIGNATURE_BATCH_SIZE=5000
INTEL_M2_DEDUPE_BATCH_SIZE=1000
INTEL_M2_CLUSTER_BATCH_SIZE=1000
INTEL_M2_MAX_LOCAL_DOCUMENTS=20000
INTEL_RULE_CLASSIFICATION_BATCH_SIZE=2000
INTEL_CLASSIFICATION_BATCH_SIZE=25
# The default non-secret profile is config/models.yaml:deepseek-v4.
# Select another profile or override individual values at deployment time.
# INTEL_LLM_CONFIG_FILE=config/models.yaml
# INTEL_LLM_PROFILE=deepseek-v4
# INTEL_LLM_PROVIDER=openai-compatible
# INTEL_LLM_BASE_URL=https://your-compatible-endpoint.example/v1
# INTEL_LLM_MODEL=deepseek-v4-flash
# INTEL_LLM_RESPONSE_FORMAT=json_object  # json_schema | json_object | prompt_only
# INTEL_LLM_THINKING_MODE=disabled  # default | enabled | disabled
# API keys are environment-only and override no YAML field because YAML cannot contain one.
# INTEL_LLM_API_KEY=
# INTEL_LLM_TIMEOUT_SECONDS=60
# INTEL_LLM_MAX_INPUT_CHARS=12000
# INTEL_LLM_MAX_OUTPUT_TOKENS=500

# --- API security ---
# Read and /ops administration use different fail-closed Bearer tokens.
INTEL_API_TOKEN=replace-with-a-long-random-read-token
INTEL_ADMIN_API_TOKEN=replace-with-a-different-long-random-admin-token

# --- M2.2 shadow semantic enrichment (disabled means zero model calls) ---
INTEL_SEMANTIC_ENRICHMENT_ENABLED=false
INTEL_SEMANTIC_ENRICHMENT_MODE=shadow
INTEL_SEMANTIC_ENRICHMENT_BATCH_SIZE=5
INTEL_SEMANTIC_LLM_MAX_OUTPUT_TOKENS=2500

# --- delivery (later milestone) ---
# INTEL_FEISHU_WEBHOOK_URL=
# INTEL_SMTP_URL=
# INTEL_ADMIN_ALERT_TARGET=
