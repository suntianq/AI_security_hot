# Copy to .env and fill in. Secrets never go in code, logs or sources.yaml.

# --- database ---
INTEL_DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5432/intel

# --- sources / storage ---
INTEL_SOURCES_FILE=sources/sources.yaml
INTEL_BLOB_DIR=data/blobs

# --- egress / proxy pools (plan 修正 3) ---
# Set the pool that matches your deployment location. Unset => direct fallback.
#   CN VM  -> set INTEL_PROXY_POOL_GLOBAL for overseas sources (GitHub/Anthropic)
#   overseas VM -> set INTEL_PROXY_POOL_CN for CN gov/vendor sources (AIVD/CNVD)
# Docker containers cannot use a host loopback proxy via 127.0.0.1. Expose it
# only on the project Docker gateway (never 0.0.0.0), then use that address:
# INTEL_PROXY_POOL_GLOBAL=http://172.18.0.1:17897
# INTEL_PROXY_POOL_CN=http://user:pass@cn-proxy:8080
# INTEL_PROXY_POOL_GLOBAL=http://user:pass@global-proxy:8080

# --- scheduler ---
INTEL_TICK_INTERVAL_SECONDS=60
INTEL_SELF_CHECK_INTERVAL_SECONDS=600
INTEL_LEASE_SECONDS=900
INTEL_NORMALIZE_INTERVAL_SECONDS=10
INTEL_FULLTEXT_INTERVAL_SECONDS=30
INTEL_NORMALIZE_BATCH_SIZE=2000
INTEL_FULLTEXT_BATCH_SIZE=20

# --- optional GitHub token for higher API rate limits ---
# GITHUB_TOKEN=ghp_xxx

# --- M1.3 classification / LLM (rule is offline and default) ---
INTEL_CLASSIFICATION_MODE=rule
INTEL_CLASSIFICATION_INTERVAL_SECONDS=30
INTEL_EVENT_INTERVAL_SECONDS=60
# Defer scheduled global M2 rebuilds while M1 backlog exceeds this; 0 disables.
INTEL_EVENT_BACKLOG_THRESHOLD=1000
INTEL_RULE_CLASSIFICATION_BATCH_SIZE=2000
INTEL_CLASSIFICATION_BATCH_SIZE=25
# To enable hybrid, set mode=hybrid and configure a registered provider:
# INTEL_LLM_PROVIDER=openai-compatible
# INTEL_LLM_BASE_URL=https://api.openai.com/v1
# INTEL_LLM_API_KEY=
# INTEL_LLM_MODEL=
# INTEL_LLM_TIMEOUT_SECONDS=30
# INTEL_LLM_MAX_INPUT_CHARS=12000
# INTEL_LLM_MAX_OUTPUT_TOKENS=500

# --- delivery (later milestone) ---
# INTEL_FEISHU_WEBHOOK_URL=
# INTEL_SMTP_URL=
# INTEL_ADMIN_ALERT_TARGET=
